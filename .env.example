# ============================================================================
# Nirvana Massage Studio — environment variables
# Copy to `.env.local` for local dev (`vercel dev`) and configure the same
# keys in the Vercel project settings for production. NEVER commit real values.
# ============================================================================

# --- Supabase (server-side only) ---------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (Project Settings > API)
SUPABASE_URL=
# service_role key — bypasses RLS; keep secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar (service account) ----------------------------------------
# Service account client email (Google Cloud Console > Service Accounts).
# The studio calendar must be shared with this address ("Make changes to events").
GOOGLE_CLIENT_EMAIL=
# Service account private key. Paste with literal \n escapes, e.g.
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# ID of the calendar used for busy-checking and booking events
# (Calendar settings > Integrate calendar; often the practitioner's gmail address).
GOOGLE_CALENDAR_ID=

# --- Email (Resend) ------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender identity (optional — default shown below).
EMAIL_FROM="Nirvana Massage Studio <bookings@nirvanamassage.pl>"

# --- Practitioner notifications -------------------------------------------------
# Fallback recipient for new-booking notifications. The value stored in the
# Supabase `settings` table (editable via the admin panel) takes precedence.
PRACTITIONER_EMAIL=heorhiievaalina@gmail.com

# --- Admin API -------------------------------------------------------------------
# Shared secret required in the `x-admin-key` header for /api/admin/* routes.
# Generate a long random string, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=
# Password the practitioner types into the admin-panel login screen.
# Exchanged for a session token at /api/admin/login.
ADMIN_PASSWORD=
# Secret used to sign admin session tokens (falls back to ADMIN_API_KEY).
# Generate a long random string, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
# Same value exposed to the frontend admin panel (VITE_ prefix makes it
# available to the client bundle — treat it as a low-trust gate, not real auth).
VITE_ADMIN_API_KEY=

# --- Stripe (online payments & subscriptions) ----------------------------------
# Secret API key (Dashboard > Developers > API keys). Use test keys until launch.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint /api/stripe-webhook
# (Dashboard > Developers > Webhooks, or from `stripe listen` in local dev).
STRIPE_WEBHOOK_SECRET=
# Public site URL used for Stripe redirect links, e.g. https://nirvanamassage.pl
# (optional — falls back to the request Host header).
SITE_URL=

# --- Supabase client-side (member accounts / magic-link sign-in) ---------------
# Same project URL as SUPABASE_URL, exposed to the frontend bundle.
VITE_SUPABASE_URL=
# anon public key (Project Settings > API) — safe to expose; RLS blocks all
# direct table access, members only ever reach data through the API routes.
VITE_SUPABASE_ANON_KEY=
